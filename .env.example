# Copy to .env and fill in. Everything is optional: without an API key the
# site runs fully offline with curated challenges and rule-based engines.

# Port for the web server
PORT=3000

# Claude API key (enables AI conversations, semantic answer checking,
# AI moderation and AI challenge generation). Can also be set in the admin panel.
ANTHROPIC_API_KEY=

# Admin dashboard password. If unset, a random one is generated on first run
# and written to data/ADMIN_PASSWORD.txt
ADMIN_PASSWORD=
